{
  "name": "@deepfirstsearch/agent-pay-ai-sdk",
  "version": "0.1.0",
  "description": "Vercel AI SDK tool: let a model fetch x402 APIs while an owner-signed, on-chain budget decides every payment",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeepFirstHQ/deepfirstsearch.git",
    "directory": "integrations/ai-sdk"
  },
  "keywords": [
    "ai-sdk",
    "vercel",
    "x402",
    "ai-agents",
    "payments",
    "usdc",
    "base"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@deepfirstsearch/agent-pay": "0.4.0",
    "ai": "7.0.128",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "viem": "2.57.3",
    "vitest": "4.1.11"
  }
}
