{
  "name": "@deepfirstsearch/agent-pay-zodiac-roles",
  "version": "0.1.0",
  "private": true,
  "description": "Zodiac Roles v2 x Agent Safe: AI agents pay for APIs over x402 from a company Safe, with team budgets, per-agent caps and on-chain limits",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeepFirstHQ/deepfirstsearch.git",
    "directory": "integrations/zodiac-roles"
  },
  "keywords": [
    "zodiac",
    "roles",
    "safe",
    "x402",
    "ai-agents",
    "payments",
    "usdc",
    "base"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepfirstsearch/agent-pay": ">=0.12.0 <1",
    "viem": "^2"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@coinbase/cdp-sdk": "1.58.0",
    "@deepfirstsearch/agent-pay": "0.12.0",
    "@privy-io/node": "0.35.0",
    "@safe-global/safe-deployments": "1.37.63",
    "@turnkey/sdk-server": "8.6.0",
    "@turnkey/viem": "0.14.45",
    "@types/node": "26.6.4",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "viem": "2.57.3",
    "vitest": "4.1.11"
  }
}
