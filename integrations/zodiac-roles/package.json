  },
  "dependencies": {
    "@deepfirstsearch/agent-pay": "0.5.3"
  },
  "devDependencies": {
    "@safe-global/safe-deployments": "1.37.63",
    "@types/node": "26.6.4",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "tsup": "8.5.1",
