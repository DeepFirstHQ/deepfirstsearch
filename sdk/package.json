{
  "name": "@deepfirstsearch/agent-pay",
  "version": "0.8.2",
  "description": "Policy-gated x402 payments for AI agents: deterministic spend policy outside the model, prompt-injection guards, per-merchant payers and on-chain Agent Safe budgets on Base.",
  "license": "MIT",
  "author": "Nicolas Tursi <nicolas@deepfirstsearch.com>",
  "homepage": "https://deepfirstsearch.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeepFirstHQ/deepfirstsearch.git",
    "directory": "sdk"
  },
  "bugs": {
    "url": "https://github.com/DeepFirstHQ/deepfirstsearch/issues"
  },
  "keywords": [
    "x402",
    "ai-agents",
    "agent-payments",
    "prompt-injection",
    "usdc",
    "base",
    "eip-3009",
    "eip-712"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/testing/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "tsx examples/agent-demo.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "viem": "^2.38.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "fast-check": "4.10.2",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "agent-pay": "dist/cli.js"
  }
}
