# Security headers for Cloudflare Pages / Netlify (same file format).
# Cloudflare Web Analytics (cookieless) is the only third-party script: Cloudflare already serves the whole site.
# GitLab Pages cannot set headers, which is why the site should be hosted on one of these.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests; require-trusted-types-for 'script'; trusted-types 'none'
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), interest-cohort=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# The vault dashboard reads Base's public JSON-RPC endpoints (read-only), so it needs a wider connect-src.
# "! Content-Security-Policy" detaches the site-wide policy above for this page; everything else stays the same.
/dashboard.html
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com https://mainnet.base.org https://sepolia.base.org https://base-rpc.publicnode.com https://base-sepolia-rpc.publicnode.com; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests; require-trusted-types-for 'script'; trusted-types 'none'

/dashboard
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com https://mainnet.base.org https://sepolia.base.org https://base-rpc.publicnode.com https://base-sepolia-rpc.publicnode.com; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests; require-trusted-types-for 'script'; trusted-types 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable
